{
  "name": "kilowatch-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Comparison service for the Kilowatch iOS app: anonymous usage cohorts and friend comparisons.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "dev": "tsc -p tsconfig.test.json && KILOWATCH_STORE=memory CRON_SECRET=dev node .test-build/scripts/dev-server.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^5.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "22.x"
  }
}
